{
    "name": "keyteki",
    "version": "2.0.0",
    "description": "KeyForge puzzle server and client",
    "main": "index.js",
    "engines": {
        "node": ">=22.12.0 <25"
    },
    "scripts": {
        "start": "node .",
        "images": "node scripts/fetch-images.js",
        "scenario:export": "node server/scenario/export.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check --ignore-unknown '!**/*.{js,jsx,ts,tsx}' . && eslint --ext=js,jsx,ts,tsx .",
        "lint:fix": "prettier --write --ignore-unknown '!**/*.{js,jsx,ts,tsx}' . && eslint --fix --ext=js,jsx,ts,tsx .",
        "build": "vite build --config vite.config.mjs",
        "typecheck:client": "tsc -p client/tsconfig.json --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keyteki/keyteki.git"
    },
    "keywords": [
        "keyforge",
        "cardgame"
    ],
    "author": "Various",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/keyteki/keyteki/issues"
    },
    "homepage": "https://github.com/keyteki/keyteki#readme",
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/react-fontawesome": "^3.2.0",
        "@heroui/react": "^3.0.0-beta.8",
        "@heroui/styles": "^3.0.0-beta.8",
        "@reduxjs/toolkit": "^2.2.3",
        "@tailwindcss/postcss": "^4.2.0",
        "classnames": "^2.5.1",
        "core-js": "^3.6.4",
        "express": "^4.22.2",
        "fabric": "^5.5.2",
        "i18next": "^17.3.1",
        "jsondiffpatch": "^0.4.1",
        "lodash.debounce": "^4.0.8",
        "moment": "^2.29.4",
        "prop-types": "^15.6.0",
        "qrcode": "^1.4.4",
        "react": "^19.2.4",
        "react-dnd": "^16.0.1",
        "react-dnd-touch-backend": "^16.0.1",
        "react-dom": "^19.2.4",
        "react-i18next": "^10.13.2",
        "react-redux": "^9.2.0",
        "react-router-dom": "^6.30.4",
        "redux": "^5.0.1",
        "regenerator-runtime": "^0.14.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "tailwindcss": "^4.2.0",
        "underscore": "^1.13.8",
        "winston": "^3.2.1"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.7.15",
        "@types/node": "^22.19.11",
        "@vitejs/plugin-react": "^5.1.4",
        "eslint": "^7.1.0",
        "eslint-config-prettier": "^6.11.0",
        "eslint-plugin-prettier": "^3.1.3",
        "eslint-plugin-react": "^7.20.0",
        "eslint-plugin-react-hooks": "^4.0.4",
        "prettier": "^2.0.5",
        "typescript": "^5.4.5",
        "vite": "^7.3.2",
        "vitest": "4.1.0"
    }
}
